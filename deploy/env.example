# Settings for docker-compose.yml. setup.sh copies this to .env and fills in
# WEB_PASSWORD, PUID and PGID. After editing .env run:  docker compose up -d

# Address and port the site listens on.
#   127.0.0.1 = this server only (put a reverse proxy with HTTPS in front, or use an SSH tunnel)
#   0.0.0.0   = every network interface (anyone who can reach the server sees the login prompt)
BIND=127.0.0.1
PORT=8080

# Login for the site. An empty WEB_PASSWORD turns the login off; only do that with BIND=127.0.0.1.
WEB_USER=admin
WEB_PASSWORD=

# Largest PDF that can be uploaded, in MB.
MAX_UPLOAD_MB=200

# CPU threads used for OCR. Empty = let PyTorch decide (usually the number of physical cores).
OCR_THREADS=

# User and group that own the webdata/ folder (the container runs as this user).
PUID=1000
PGID=1000

# Model to download and the exact revision that was tested.
MODEL_REPO=iapp/OpenThai2.1-OCR-Markdown-20261118
MODEL_REVISION=c974dc7d18a4511a21988f4a1d12fad07ac16625

# Re-read sideways pages and plan/map pages turned 90 degrees (1 = on, 0 = off).
# On CPU each such page takes about three times as long.
OCR_ROTATE=1
